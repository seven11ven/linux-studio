#!/bin/sh
# Linux Studio post-install. No network, no prompts, safe to run more than once.
set -e

PROFILE=/etc/apparmor.d/io.github.seven11ven.linuxstudio
COPY=/opt/linux-studio/libexec/bwrap

copy_bwrap() {
    # Linux Studio uses its own copy of Ubuntu's bwrap so the AppArmor permission applies to it alone.
    install -m 0755 -o root -g root /usr/bin/bwrap "$COPY.new"
    mv -f "$COPY.new" "$COPY"
}

load_profile() {
    if command -v apparmor_parser >/dev/null 2>&1 && [ -d /sys/kernel/security/apparmor ]; then
        apparmor_parser -r -T -W "$PROFILE" || echo "linux-studio: warning: could not load the AppArmor profile; run 'linux-studio --self-test' after a reboot." >&2
    fi
}

case "$1" in
    configure|triggered)
        copy_bwrap
        load_profile
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
