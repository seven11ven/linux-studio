#!/usr/bin/env bash
# Linux Studio launcher: builds the sandbox ("locked room") with bubblewrap and starts the editor in it.
#
# Inside the sandbox the editor can see ONLY:
#   /                 the bundled mini-Linux (read-only)
#   /app              the editor itself (read-only)
#   /home/user        Linux Studio's own private settings/extensions folder
#   /project-folder   the one project folder you chose
# It has no network devices of its own: its only way out is the approved-websites proxy (HTTPS only,
# sites you approve), plus a fake identity (computer "studio", user "user", new random machine-id every
# launch), no /sys, and no GPU unless --gpu.
#
# Usage:
#   linux-studio                          start the editor
#   linux-studio --network                open the "Approved websites" window
#   linux-studio --settings               open Linux Studio's settings (clipboard, display)
#   linux-studio --toolchains             open the Toolchains explorer (online only while it's open)
#   linux-studio --set-project-folder P   choose the project folder
#   linux-studio --shell [-c COMMAND]     open a terminal in the same sandbox (testing/debugging)
#   linux-studio --self-test              check that the sandbox works on this computer
#   linux-studio --gpu                    allow the graphics card (off by default for privacy)
#   linux-studio --unsafe-direct-x11      X11 without the private display (NOT recommended: code inside could read
#                                         your screen and type into other windows)
#   linux-studio --editor-dir D --runtime-dir D   use a development build instead of /opt/linux-studio
set -euo pipefail

PROG="linux-studio"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/linux-studio"
CONFIG_FILE="$CONFIG_DIR/config"
STATE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/linux-studio"
SANDBOX_HOME="$STATE_DIR/home"

SELF="$(readlink -f "$0")"
HERE="$(dirname "$SELF")"
if [[ -d /opt/linux-studio/share ]]; then SHARE=/opt/linux-studio/share; else SHARE="$(cd "$HERE/.." && pwd)"; fi
SETTINGS_SRC="$SHARE/editor/default-settings.json"
INITIAL_SETTINGS="$SHARE/editor/initial-settings.json"
APPLY_SETTINGS="$SHARE/launcher/apply_settings.py"
FIRST_RUN="$SHARE/first-run/first_run.py"
NETWORK_DIR="$SHARE/network"
NETWORK_CONFIG="$CONFIG_DIR/network.json"
TOOLCHAINS_DIR="$STATE_DIR/toolchains"
TOOLCHAINS_SRC="$SHARE/toolchains"
EDITOR_DIR=/opt/linux-studio/editor
RUNTIME_DIR=/opt/linux-studio/runtime

die()  { echo "$PROG: $*" >&2; exit 1; }
warn() { echo "$PROG: warning: $*" >&2; }

# ---------- project folder: validate, save, load ----------

# Prints the cleaned absolute path, or fails with a reason. Used by --set-project-folder and the first-run window.
validate_project_folder() {
  local raw="$1" p
  [[ -n "$raw" ]] || die "no folder given"
  [[ "$raw" != *$'\n'* ]] || die "folder names with line breaks are not supported"
  raw="${raw/#\~/$HOME}"
  p="$(realpath -m -- "$raw")"
  case "$p" in
    /|/bin|/boot|/dev|/etc|/lib|/lib32|/lib64|/libx32|/opt|/proc|/root|/run|/sbin|/srv|/sys|/tmp|/usr|/var|/home|/media|/mnt)
      die "'$p' is a system folder. Choose or create a dedicated folder, e.g. ~/LinuxStudio/project-folder" ;;
    /bin/*|/boot/*|/dev/*|/etc/*|/lib/*|/lib64/*|/proc/*|/run/*|/sbin/*|/sys/*|/usr/*|/var/*)
      die "'$p' is inside a system folder" ;;
  esac
  local home; home="$(realpath -m -- "$HOME")"
  [[ "$p" != "$home" ]] || die "that is your whole home folder. Choose a dedicated folder inside it"
  [[ "$home/" != "$p/"* ]] || die "'$p' contains your home folder"
  local s; for s in "$STATE_DIR" "$CONFIG_DIR"; do
    s="$(realpath -m -- "$s")"
    [[ "$s/" != "$p/"* && "$p/" != "$s/"* ]] || die "'$p' overlaps Linux Studio's own settings folder ($s)"
  done
  printf '%s\n' "$p"
}

# Settings file: simple KEY=value lines, read without ever executing it. Written only by this launcher.
get_setting() {   # get_setting KEY DEFAULT
  local line=""; [[ -f "$CONFIG_FILE" ]] && line="$(grep -m1 "^$1=" "$CONFIG_FILE" || true)"
  if [[ -n "$line" ]]; then printf '%s\n' "${line#*=}"; else printf '%s\n' "$2"; fi
}
set_setting() {   # set_setting KEY VALUE  (keeps every other setting; replaces the file in one step)
  mkdir -p "$CONFIG_DIR"; chmod 700 "$CONFIG_DIR"
  { [[ -f "$CONFIG_FILE" ]] && grep -v "^$1=" "$CONFIG_FILE" || true; printf '%s=%s\n' "$1" "$2"; } > "$CONFIG_FILE.tmp"
  chmod 600 "$CONFIG_FILE.tmp"; mv "$CONFIG_FILE.tmp" "$CONFIG_FILE"
}

save_project_folder() {
  local p; p="$(validate_project_folder "$1")"
  mkdir -p -- "$p"
  mkdir -p "$CONFIG_DIR"; chmod 700 "$CONFIG_DIR"
  set_setting PROJECT_FOLDER "$p"
  echo "Project folder set to: $p"
}

# Read the config without executing it (never `source` a settings file).
load_project_folder() {
  [[ -f "$CONFIG_FILE" ]] || return 1
  local line; line="$(grep -m1 '^PROJECT_FOLDER=' "$CONFIG_FILE" || true)"
  PROJECT_FOLDER="${line#PROJECT_FOLDER=}"
  [[ -n "$PROJECT_FOLDER" && -d "$PROJECT_FOLDER" ]] || return 1
  PROJECT_FOLDER="$(validate_project_folder "$PROJECT_FOLDER")"
}

first_run() {
  if [[ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]] && /usr/bin/python3 -c 'import gi; gi.require_version("Gtk","4.0")' 2>/dev/null; then
    /usr/bin/python3 "$FIRST_RUN" "$SELF" || exit 0     # window closed with "Quit"
  else
    echo "Linux Studio can only see one folder. Choose where your project folder should live."
    local ans; read -r -p "Project folder [~/LinuxStudio/project-folder]: " ans
    save_project_folder "${ans:-$HOME/LinuxStudio/project-folder}"
  fi
}

# ---------- arguments ----------
MODE=editor; GPU=0; UNSAFE_X11=0; SHELL_CMD=()
while (( $# )); do
  case "$1" in
    --set-project-folder) (( $# >= 2 )) || die "--set-project-folder needs a path"; save_project_folder "$2"; exit 0 ;;
    --validate-project-folder) validate_project_folder "${2:-}"; exit 0 ;;   # used by the first-run window
    --network) exec /usr/bin/python3 "$NETWORK_DIR/sites_manager.py" --config "$NETWORK_CONFIG" ;;
    --settings) exec /usr/bin/python3 "$SHARE/settings/settings_window.py" "$SELF" ;;
    --get-clipboard) get_setting CLIPBOARD paste-only; exit 0 ;;   # used by the Settings window and the clipboard bridge
    --set-clipboard)
      [[ "${2:-}" == paste-only || "${2:-}" == both ]] || die "--set-clipboard needs paste-only or both"
      set_setting CLIPBOARD "$2"; echo "Clipboard: $2"; exit 0 ;;
    --toolchains) MODE=toolchains-ui ;;
    --toolchains-worker) MODE=toolchains-worker ;;   # internal: started by the Toolchains explorer
    --self-test) MODE=selftest ;;
    --shell) MODE=shell; shift; SHELL_CMD=("$@"); break ;;
    --gpu) GPU=1 ;;
    --allow-x11) echo "linux-studio: --allow-x11 is no longer needed: X11 desktops now get a private, isolated display." >&2 ;;
    --unsafe-direct-x11) UNSAFE_X11=1 ;;
    --editor-dir) EDITOR_DIR="$(realpath -- "${2:?}")"; shift ;;
    --runtime-dir) RUNTIME_DIR="$(realpath -- "${2:?}")"; shift ;;
    -h|--help) sed -n '2,20p' "$SELF" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) die "unknown option: $1 (see --help)" ;;
  esac
  shift
done

# Installed package: Linux Studio's own copy of the system bwrap, which is the only program the Linux Studio
# AppArmor profile allows to create sandboxes (Ubuntu 24.04+). Development: the system bwrap.
BWRAP=/opt/linux-studio/libexec/bwrap
if [[ ! -x "$BWRAP" ]]; then
  if [[ "$SELF" == /opt/linux-studio/* ]]; then BWRAP=/usr/bin/bwrap   # installed: never search PATH (review #5)
  else BWRAP="$(command -v bwrap || true)"; fi
fi
[[ -n "$BWRAP" ]] || die "bubblewrap (bwrap) is not installed"
if [[ $MODE == toolchains-ui ]]; then
  WORKER_CMD=("$SELF" --runtime-dir "$RUNTIME_DIR" --toolchains-worker)
  exec /usr/bin/python3 "$TOOLCHAINS_SRC/explorer.py" -- "${WORKER_CMD[@]}"
fi
[[ -x "$RUNTIME_DIR/usr/bin/bash" ]] || die "runtime not found at $RUNTIME_DIR (use --runtime-dir)"
if [[ $MODE == editor ]]; then
  [[ -x "$EDITOR_DIR/linux-studio-editor" ]] || die "editor not found at $EDITOR_DIR (use --editor-dir)"
fi

if [[ $MODE == selftest ]]; then
  # A throwaway project folder; the checks never touch your real one.
  SELFTEST_DIR="$(mktemp -d "${TMPDIR:-/tmp}/linux-studio-selftest.XXXXXXXX")"
  trap 'rm -rf -- "$SELFTEST_DIR"' EXIT INT TERM   # replaced by the full cleanup below (review #6)
  PROJECT_FOLDER="$SELFTEST_DIR"
  MODE=shell
  SHELL_CMD=(-c '
    ok=0; bad=0
    t() { if eval "$2" >/dev/null 2>&1; then echo "PASS  $1"; ok=$((ok+1)); else echo "FAIL  $1"; bad=$((bad+1)); fi; }
    t "Sandbox started"                          true
    t "Fake computer name (studio)"              "[ \"\$(hostname)\" = studio ]"
    t "Fake user name (user)"                    "[ \"\$(whoami)\" = user ]"
    t "Your home folder is hidden"               "[ \"\$(ls -A /home)\" = user ]"
    t "No network devices except loopback"       "[ \"\$(ip -o link | wc -l)\" = 1 ]"
    t "No direct internet"                       "! curl --noproxy \"*\" -s -m 5 https://example.com"
    t "Proxy bridge is running"                  "exec 3<>/dev/tcp/127.0.0.1/3128"
    if [ "${LS_PRIVATE_X11:-}" = 1 ]; then
      t "X11: only Linux Studio'"'"'s private display is visible"  "[ \"\$(ls /tmp/.X11-unix | wc -l)\" = 1 ] && [ \"/tmp/.X11-unix/X\${DISPLAY#:}\" = \"\$(ls -d /tmp/.X11-unix/*)\" ]"
      t "X11: private display is running"                        "xdpyinfo >/dev/null"
      t "X11: no fake-keyboard (XTEST) on the private display"   "! xdpyinfo -queryExtensions | grep -q XTEST"
    elif [ -n "${DISPLAY:-}" ]; then
      echo "INFO  X11 direct mode (--unsafe-direct-x11): code inside could see your other windows"
    fi
    if /usr/bin/bwrap --unshare-all --ro-bind / / --proc /proc --dev /dev true >/dev/null 2>&1; then
      echo "INFO  Inner sandboxes available (editor web-content sandbox and Rust installer sandbox are on)"
    else
      echo "INFO  Inner sandboxes not allowed here (normal on Ubuntu 24.04+): editor web-content and Rust installer"
      echo "      sandboxes are off; Linux Studio'"'"'s main sandbox still isolates everything"
    fi
    echo; echo "$ok passed, $bad failed"; [ $bad = 0 ]')
elif [[ $MODE != toolchains-worker ]]; then
  load_project_folder || { first_run; load_project_folder || die "no project folder set"; }
fi
mkdir -p "$SANDBOX_HOME" "$TOOLCHAINS_DIR"; chmod 700 "$STATE_DIR" "$SANDBOX_HOME" "$TOOLCHAINS_DIR"

# ---------- per-launch fake identity (deleted on exit) ----------
RUNTIME_TMP="$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/linux-studio.XXXXXXXX")"
PROXY_PID=""
cleanup() {
  local p
  for p in "${BRIDGE_PID:-}" "${XEPHYR_PID:-}" "$PROXY_PID"; do
    if [[ -n "$p" ]]; then kill "$p" 2>/dev/null || true; wait "$p" 2>/dev/null || true; fi
  done
  rm -rf -- "$RUNTIME_TMP"
  [[ -z "${SELFTEST_DIR:-}" ]] || rm -rf -- "$SELFTEST_DIR"
}
trap cleanup EXIT INT TERM
printf 'root:x:0:0::/root:/usr/sbin/nologin\nuser:x:1000:1000:user:/home/user:/bin/bash\nnobody:x:65534:65534::/nonexistent:/usr/sbin/nologin\n' > "$RUNTIME_TMP/passwd"
printf 'root:x:0:\nuser:x:1000:\nnogroup:x:65534:\n' > "$RUNTIME_TMP/group"
printf 'studio\n' > "$RUNTIME_TMP/hostname"
printf '127.0.0.1 localhost\n127.0.1.1 studio\n::1 localhost\n' > "$RUNTIME_TMP/hosts"
od -An -tx1 -N16 /dev/urandom | tr -d ' \n' > "$RUNTIME_TMP/machine-id"; echo >> "$RUNTIME_TMP/machine-id"
: > "$RUNTIME_TMP/resolv.conf"   # no name servers: names are looked up only by the proxy, outside

# ---------- approved-websites proxy (stopped in cleanup) ----------
mkdir -p "$CONFIG_DIR"; chmod 700 "$CONFIG_DIR"
if [[ $MODE == toolchains-worker ]]; then   # official download sites only, no pop-ups
  /usr/bin/python3 "$NETWORK_DIR/studio_proxy.py" --socket "$RUNTIME_TMP/proxy.sock" \
    --fixed-allowlist "$TOOLCHAINS_SRC/official-sites.json" --parent-pid $$ &
else
  /usr/bin/python3 "$NETWORK_DIR/studio_proxy.py" --socket "$RUNTIME_TMP/proxy.sock" --config "$NETWORK_CONFIG" \
    --prompt "$NETWORK_DIR/approval_prompt.py" --parent-pid $$ &
fi
PROXY_PID=$!
for _ in $(seq 50); do [[ -S "$RUNTIME_TMP/proxy.sock" ]] && break; sleep 0.1; done
[[ -S "$RUNTIME_TMP/proxy.sock" ]] || die "the network proxy didn't start"

# ---------- sandbox ----------
ARGS=(
  --unshare-all --die-with-parent --new-session --clearenv --cap-drop ALL
  --hostname studio --uid 1000 --gid 1000
  --ro-bind "$RUNTIME_DIR" /
  --proc /proc --dev /dev --tmpfs /tmp --tmpfs /run --dir /run/user/1000 --chmod 0700 /run/user/1000
  --ro-bind "$RUNTIME_TMP/passwd" /etc/passwd
  --ro-bind "$RUNTIME_TMP/group" /etc/group
  --ro-bind "$RUNTIME_TMP/hostname" /etc/hostname
  --ro-bind "$RUNTIME_TMP/hosts" /etc/hosts
  --ro-bind "$RUNTIME_TMP/machine-id" /etc/machine-id
  --ro-bind "$RUNTIME_TMP/resolv.conf" /etc/resolv.conf
  --dir /run/linux-studio
  --ro-bind "$RUNTIME_TMP/proxy.sock" /run/linux-studio/proxy.sock
  --ro-bind "$NETWORK_DIR/net_bridge.py" /run/linux-studio/net_bridge.py
  --setenv GOTOOLCHAIN local --setenv CARGO_HOME /home/user/.cargo
  --setenv HOME /home/user --setenv USER user --setenv LOGNAME user --setenv SHELL /bin/bash
  --setenv PATH /usr/local/bin:/usr/bin:/bin --setenv LANG C.UTF-8 --setenv TERM xterm-256color
  --setenv XDG_RUNTIME_DIR /run/user/1000
  --setenv PIP_DISABLE_PIP_VERSION_CHECK 1 --setenv NPM_CONFIG_UPDATE_NOTIFIER false
  --setenv NPM_CONFIG_AUDIT false --setenv NPM_CONFIG_FUND false
  --setenv HTTPS_PROXY http://127.0.0.1:3128 --setenv https_proxy http://127.0.0.1:3128
  --setenv HTTP_PROXY http://127.0.0.1:3128 --setenv http_proxy http://127.0.0.1:3128
  --setenv ALL_PROXY http://127.0.0.1:3128 --setenv all_proxy http://127.0.0.1:3128
  --setenv NO_PROXY localhost,127.0.0.1,::1 --setenv no_proxy localhost,127.0.0.1,::1
  --chdir /project-folder
)
if [[ $MODE == toolchains-worker ]]; then
  # Downloader sandbox: writes ONLY to the toolchains folder; no project folder, no editor home.
  ARGS+=(--tmpfs /home/user --bind "$TOOLCHAINS_DIR" /toolchains
         --ro-bind "$TOOLCHAINS_SRC/keys" /run/linux-studio/keys
         --ro-bind "$TOOLCHAINS_SRC/worker.py" /run/linux-studio/worker.py)
else
  ARGS+=(--bind "$SANDBOX_HOME" /home/user --bind "$PROJECT_FOLDER" /project-folder
         --ro-bind "$TOOLCHAINS_DIR" /toolchains)
fi
if [[ $MODE == editor ]]; then
  ARGS+=(--ro-bind "$EDITOR_DIR" /app
         --ro-bind "$SETTINGS_SRC" /run/linux-studio/locked-settings.json
         --ro-bind "$INITIAL_SETTINGS" /run/linux-studio/initial-settings.json
         --ro-bind "$APPLY_SETTINGS" /run/linux-studio/apply_settings.py)
fi
if (( GPU )) && [[ -d /dev/dri ]]; then ARGS+=(--dev-bind /dev/dri /dev/dri); fi

# ---------- X11: a private display (Xephyr) so code inside can't see or type into your other windows ----------
# Xephyr and the clipboard bridge each run in a small sandbox (security review, Phase 6): only the system's
# programs and settings (/usr, /etc), no home or other disks, a clean environment and no special permissions.
X_SANDBOX_BASE=(--unshare-all --die-with-parent --new-session --clearenv --cap-drop ALL
                --ro-bind /usr /usr --ro-bind /etc /etc --symlink usr/bin /bin --symlink usr/sbin /sbin
                --symlink usr/lib /lib --symlink usr/lib64 /lib64 --proc /proc --dev /dev --tmpfs /tmp --tmpfs /run
                --setenv PATH /usr/bin:/bin --setenv HOME /tmp --setenv LANG C.UTF-8)
setup_x11() {   # setup_x11 HOST_DISPLAY_NUMBER
  local h="$1" x_sock="/tmp/.X11-unix/X$1" xauth_src="${XAUTHORITY:-$HOME/.Xauthority}"
  [[ -S "$x_sock" ]] || die "X11 display :$h has no socket at $x_sock"
  # Host login cookie as a "wildcard" entry, so it works from inside sandboxes (different computer name).
  : > "$RUNTIME_TMP/host.xauth"
  if [[ -f "$xauth_src" ]]; then   # (cookies only ever travel through pipes, never command arguments)
    XAUTHORITY="$xauth_src" xauth nlist ":$h" 2>/dev/null | sed 's/^..../ffff/' | xauth -f "$RUNTIME_TMP/host.xauth" nmerge - 2>/dev/null || true
  fi
  if (( UNSAFE_X11 )); then
    warn "--unsafe-direct-x11: code inside Linux Studio could read your screen and type into other windows."
    ARGS+=(--ro-bind "$x_sock" "$x_sock" --setenv DISPLAY ":$h"
           --ro-bind "$RUNTIME_TMP/host.xauth" /run/user/1000/Xauthority --setenv XAUTHORITY /run/user/1000/Xauthority)
    return
  fi
  command -v Xephyr >/dev/null || die "the 'xserver-xephyr' package is needed for Linux Studio's private X11 display"
  local n=7; [[ "$h" == 7 ]] && n=8
  local xdir="$RUNTIME_TMP/x11"; mkdir -m 0700 "$xdir"
  # A fresh random cookie: only Linux Studio and the bridge can connect to the private display.
  local cookie; cookie="$(od -An -tx1 -N16 /dev/urandom | tr -d ' \n')"
  printf 'add :%s MIT-MAGIC-COOKIE-1 %s\n' "$n" "$cookie" | xauth -f "$RUNTIME_TMP/nested.local" source - 2>/dev/null
  xauth -f "$RUNTIME_TMP/nested.local" nlist ":$n" | sed 's/^..../ffff/' | xauth -f "$RUNTIME_TMP/nested.xauth" nmerge - 2>/dev/null
  rm -f "$RUNTIME_TMP/nested.local"
  # The bridge's X library needs cookies named for its own (fixed) computer name instead of wildcards.
  printf 'add ls-bridge/unix:%s MIT-MAGIC-COOKIE-1 %s\n' "$n" "$cookie" | xauth -f "$RUNTIME_TMP/bridge.xauth" source - 2>/dev/null
  local host_cookie=""
  [[ -f "$xauth_src" ]] && host_cookie="$(XAUTHORITY="$xauth_src" xauth list ":$h" 2>/dev/null | awk '$2=="MIT-MAGIC-COOKIE-1"{print $3; exit}')"
  [[ -z "$host_cookie" ]] || printf 'add ls-bridge/unix:%s MIT-MAGIC-COOKIE-1 %s\n' "$h" "$host_cookie" | xauth -f "$RUNTIME_TMP/bridge.xauth" source - 2>/dev/null
  [[ -f "$RUNTIME_TMP/bridge.xauth" ]] || : > "$RUNTIME_TMP/bridge.xauth"
  local size; size="$(DISPLAY=":$h" XAUTHORITY="$xauth_src" /usr/bin/python3 -c '
from Xlib import display
s = display.Display().screen(); print(f"{int(s.width_in_pixels*0.85)}x{int(s.height_in_pixels*0.85)}")' 2>/dev/null || echo 1280x800)"
  # Xephyr in its own sandbox: sees your display socket and its own socket folder, not your files.
  "$BWRAP" "${X_SANDBOX_BASE[@]}" --bind "$xdir" /tmp/.X11-unix --ro-bind "$x_sock" "/tmp/.X11-unix/X$h" \
    --ro-bind "$RUNTIME_TMP/host.xauth" /run/host.xauth --ro-bind "$RUNTIME_TMP/nested.xauth" /run/nested.xauth \
    --setenv DISPLAY ":$h" --setenv XAUTHORITY /run/host.xauth \
    Xephyr ":$n" -auth /run/nested.xauth -title "Linux Studio" -resizeable -screen "$size" \
      -nolisten tcp -nolisten local -no-host-grab \
      -extension XTEST -extension GLX -extension XVideo -extension MIT-SCREEN-SAVER -extension X-Resource >/dev/null 2>&1 &
  XEPHYR_PID=$!
  local i; for i in $(seq 100); do [[ -S "$xdir/X$n" ]] && break; sleep 0.1; done
  [[ -S "$xdir/X$n" ]] || die "Linux Studio's private X11 display didn't start"
  # Clipboard bridge in its own sandbox: the two display sockets + your settings folder (read-only).
  "$BWRAP" "${X_SANDBOX_BASE[@]}" --bind "$xdir" /tmp/.X11-unix --ro-bind "$x_sock" "/tmp/.X11-unix/X$h" \
    --hostname ls-bridge --ro-bind "$RUNTIME_TMP/bridge.xauth" /run/bridge.xauth --setenv XAUTHORITY /run/bridge.xauth \
    --ro-bind "$CONFIG_DIR" /run/config --ro-bind "$SHARE/display" /run/display \
    /usr/bin/python3 /run/display/clipboard_bridge.py --host ":$h" --nested ":$n" --config-dir /run/config &
  BRIDGE_PID=$!
  # Window name and icon on your desktop: Xephyr calls its window "Xephyr" with no icon; this short helper labels it
  # "linux-studio-editor" (the menu entry's StartupWMClass) with the LS icon, then exits. Cosmetic only.
  "$BWRAP" "${X_SANDBOX_BASE[@]}" --ro-bind "$x_sock" "/tmp/.X11-unix/X$h" \
    --hostname ls-bridge --ro-bind "$RUNTIME_TMP/bridge.xauth" /run/bridge.xauth --setenv XAUTHORITY /run/bridge.xauth \
    --ro-bind "$SHARE/display" /run/display \
    /usr/bin/python3 /run/display/window_label.py --host ":$h" --title "Linux Studio" --wm-class linux-studio-editor \
      /run/display/icons/ls-32.png /run/display/icons/ls-64.png /run/display/icons/ls-128.png &
  # The editor sees ONLY the private display.
  ARGS+=(--ro-bind "$xdir/X$n" "/tmp/.X11-unix/X$n" --setenv DISPLAY ":$n"
         --ro-bind "$RUNTIME_TMP/nested.xauth" /run/user/1000/Xauthority --setenv XAUTHORITY /run/user/1000/Xauthority
         --setenv LS_PRIVATE_X11 1)
}

EDITOR_FLAGS=()
# Self-test on an X11 desktop: start the private display too, so its isolation can be checked.
if [[ -n "${SELFTEST_DIR:-}" && -z "${WAYLAND_DISPLAY:-}" && "${DISPLAY:-}" =~ ^:([0-9]+)(\.[0-9]+)?$ ]]; then
  setup_x11 "${BASH_REMATCH[1]}"
fi
if [[ $MODE == editor ]]; then
  if [[ -n "${WAYLAND_DISPLAY:-}" && -S "${XDG_RUNTIME_DIR:-/nonexistent}/$WAYLAND_DISPLAY" ]]; then
    ARGS+=(--ro-bind "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" /run/user/1000/wayland-0 --setenv WAYLAND_DISPLAY wayland-0)
    EDITOR_FLAGS+=(--ozone-platform=wayland)
  elif [[ "${DISPLAY:-}" =~ ^:([0-9]+)(\.[0-9]+)?$ ]]; then
    setup_x11 "${BASH_REMATCH[1]}"
    EDITOR_FLAGS+=(--ozone-platform=x11)
  else
    die "no display found (WAYLAND_DISPLAY or DISPLAY)"
  fi
  (( GPU )) || EDITOR_FLAGS+=(--disable-gpu)
  EDITOR_FLAGS+=(--password-store=basic)
fi

# Inside the sandbox: start the proxy bridge (127.0.0.1:3128 -> proxy socket), then the real program.
START=(/bin/bash -c '/usr/bin/python3 /run/linux-studio/net_bridge.py || { echo "network bridge failed" >&2; exit 1; }
  if [ -e /run/linux-studio/apply_settings.py ]; then /usr/bin/python3 /run/linux-studio/apply_settings.py || exit 1
    # Under Ubuntu'"'"'s restricted AppArmor design nothing inside may use kernel capabilities, so Chromium'"'"'s own
    # inner sandbox cannot start; Linux Studio'"'"'s main sandbox still isolates the editor (PM decision).
    /usr/bin/bwrap --unshare-all --ro-bind / / --proc /proc --dev /dev true >/dev/null 2>&1 || set -- "$@" --no-sandbox
  fi
  mkdir -p "$HOME/.config/go/telemetry" && printf "off\n" > "$HOME/.config/go/telemetry/mode"   # Go telemetry off
  if [ "${LS_PRIVATE_X11:-}" = 1 ] && [ -x /usr/bin/matchbox-window-manager ]; then
    /usr/bin/matchbox-window-manager -use_titlebar no >/dev/null 2>&1 &   # keeps the editor filling the window
  fi
  for d in /toolchains/*/current/bin; do [ -d "$d" ] && PATH="$d:$PATH"; done
  [ -d /toolchains/java/current ] && export JAVA_HOME=/toolchains/java/current
  export PATH
  exec "$@"' linux-studio)

# Not `exec`, so the cleanup trap still stops the proxy afterwards.
if [[ $MODE == toolchains-worker ]]; then
  # The worker gets a fixed PATH and never the installed toolchains first (security review #1).
  WORKER_START=(/bin/bash -c '/usr/bin/python3 /run/linux-studio/net_bridge.py || { echo "network bridge failed" >&2; exit 1; }
  export PATH=/usr/bin:/bin; exec "$@"' linux-studio)
  "$BWRAP" "${ARGS[@]}" "${WORKER_START[@]}" /usr/bin/python3 /run/linux-studio/worker.py
elif [[ $MODE == shell ]]; then
  if (( ${#SHELL_CMD[@]} )); then
    "$BWRAP" "${ARGS[@]}" "${START[@]}" /bin/bash "${SHELL_CMD[@]}"
  else
    "$BWRAP" "${ARGS[@]}" "${START[@]}" /bin/bash -i
  fi
else
  "$BWRAP" "${ARGS[@]}" "${START[@]}" /app/linux-studio-editor "${EDITOR_FLAGS[@]}" \
    --user-data-dir /home/user/.config/linux-studio \
    --extensions-dir /home/user/.linux-studio/extensions \
    /project-folder
fi
