  ],
  "__remove": [
    "voiceWsUrl",
    "trustedExtensionAuthAccess",
    "updateUrl",
    "aiConfig",
    "ariaKey",
    "enableTelemetry"
  ],
  "__neutralise_urls": [
    "defaultChatAgent"
  ]
